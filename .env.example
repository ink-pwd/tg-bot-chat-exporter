# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF

# Ключ шифрования сохранённых сообщений бесед. Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Для смены ключа: НОВЫЙ,СТАРЫЙ через запятую — старые сообщения продолжат читаться.
# Потеря ключа = сохранённую историю бесед больше не прочитать.
MESSAGE_ENCRYPTION_KEY=

# Сколько дней хранить сохранённые сообщения бесед. В боте можно выгрузить
# сегодня и 6 предыдущих дней, поэтому меньше 7 ставить не стоит.
MESSAGE_RETENTION_DAYS=7

# Telegram id пользователей, которые могут пользоваться ботом и подключать беседы,
# через запятую. Пусто — всем.
ALLOWED_USER_IDS=

# Часовой пояс по умолчанию — для пользователей, которые не выбрали свой в настройках бота
DEFAULT_TIMEZONE=Europe/Kyiv
# Сколько выгрузок может идти одновременно (по всем пользователям)
EXPORT_CONCURRENCY=3

# MySQL (используются docker-compose; пароль без символов @ : / ? #)
MYSQL_DATABASE=tg_exporter
MYSQL_USER=tg_exporter
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

LOG_LEVEL=INFO
# Сколько дней хранить файлы логов (в Docker они пишутся в ./logs)
LOG_RETENTION_DAYS=30
