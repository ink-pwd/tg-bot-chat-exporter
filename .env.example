# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF

# Ключи с https://my.telegram.org → API development tools (одни на все аккаунты)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Ключ шифрования сессий. Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Для смены ключа: НОВЫЙ,СТАРЫЙ через запятую — старые сессии продолжат читаться.
# Потеря ключа = все аккаунты придётся подключать заново.
SESSION_ENCRYPTION_KEY=

# Telegram id пользователей, которым доступен бот, через запятую. Пусто — всем.
ALLOWED_USER_IDS=

# Часовой пояс, по которому считаются границы суток для выгрузок
DEFAULT_TIMEZONE=Europe/Kyiv
# Сколько выгрузок может идти одновременно (по всем пользователям)
EXPORT_CONCURRENCY=3

# MySQL (используются docker-compose; пароль без символов @ : / ? #)
MYSQL_DATABASE=tg_exporter
MYSQL_USER=tg_exporter
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

LOG_LEVEL=INFO
# Сколько дней хранить файлы логов (в Docker они пишутся в ./logs)
LOG_RETENTION_DAYS=30
